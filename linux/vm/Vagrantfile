# linux/vm/Vagrantfile
# Rocky Linux 9 VM for SELinux and firewalld testing.
# Uses libvirt provider (required when KVM is loaded — VirtualBox conflicts with KVM).
#
# Usage:
#   vagrant up
#   vagrant ssh
#   vagrant halt
#   vagrant destroy -f
#
# Prerequisites:
#   sudo apt install libvirt-daemon-system libvirt-dev ruby-dev build-essential
#   vagrant plugin install vagrant-libvirt

# generic/rocky9 is used instead of rockylinux/9 because rockylinux/9
# has no working libvirt build on Vagrant Cloud (returns 404).
Vagrant.configure("2") do |config|
  config.vm.box = "generic/rocky9"
  config.vm.hostname = "web-node-vm"

  # libvirt provider — compatible with KVM
  config.vm.provider "libvirt" do |lv|
    lv.memory = 2048
    lv.cpus   = 2
    lv.driver = "kvm"
  end

  # Sync the linux/ directory into the VM so scripts and tests are available
  # Default synced folder uses rsync — no NFS or guest additions needed
  config.vm.synced_folder "..", "/vagrant", type: "rsync",
    rsync__exclude: [".git/", "tests/bats-core/.git/"]

  # Single provisioner runs all three scripts in one SSH session.
  # Multiple vagrant-libvirt inline provisioners open separate SSH connections;
  # the second connection fails with SCP 255 after the first session closes.
  # Combining into one inline script avoids that bug entirely.
  # Note: VAGRANT_SKIP_SSHD=1 skips sshd_config patching during provisioning
  # to prevent breaking Vagrant's SSH connection. After 'vagrant up', run:
  #   vagrant ssh -c "sudo bash /vagrant/harden.sh"
  # to apply the sshd hardening settings.
  config.vm.provision "shell", name: "baseline", inline: <<-SHELL
    set -e
    echo "==> Running harden.sh (VAGRANT_SKIP_SSHD=1)..."
    VAGRANT_SKIP_SSHD=1 bash /vagrant/harden.sh

    echo "==> Temporarily setting SELinux permissive for provisioning..."
    setenforce 0

    echo "==> Running selinux.sh..."
    bash /vagrant/vm-only/selinux.sh

    echo "==> Running firewall.sh..."
    bash /vagrant/vm-only/firewall.sh

    echo "==> Restoring SELinux to Enforcing..."
    restorecon -R /etc/ssh/ 2>/dev/null || true
    setenforce 1

    echo "==> All provisioners complete."
  SHELL
end
