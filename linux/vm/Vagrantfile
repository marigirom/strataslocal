# linux/vm/Vagrantfile
# Rocky Linux 9 VM for SELinux and firewalld testing.
# Uses libvirt provider (required when KVM is loaded — VirtualBox conflicts with KVM).
#
# Usage:
#   vagrant up
#   vagrant ssh
#   vagrant halt
#   vagrant destroy -f
#
# Prerequisites:
#   sudo apt install libvirt-daemon-system libvirt-dev ruby-dev build-essential
#   vagrant plugin install vagrant-libvirt

# generic/rocky9 is used instead of rockylinux/9 because rockylinux/9
# has no working libvirt build on Vagrant Cloud (returns 404).
Vagrant.configure("2") do |config|
  config.vm.box = "generic/rocky9"
  config.vm.hostname = "web-node-vm"

  # libvirt provider — compatible with KVM
  config.vm.provider "libvirt" do |lv|
    lv.memory = 2048
    lv.cpus   = 2
    lv.driver = "kvm"
  end

  # Sync the linux/ directory into the VM so scripts and tests are available
  # Default synced folder uses rsync — no NFS or guest additions needed
  config.vm.synced_folder "..", "/vagrant", type: "rsync",
    rsync__exclude: [".git/", "tests/bats-core/.git/"]

  # Use inline provisioners that call scripts via the synced folder (/vagrant/).
  # This avoids Vagrant's SCP upload (net-scp 255 errors with vagrant-libvirt)
  # since the scripts are already available via rsync at /vagrant/.

  # harden.sh: VAGRANT_SKIP_SSHD=1 skips sshd_config patching during provisioning
  # (patching mid-session would break SSH for subsequent provisioners).
  # After 'vagrant up', run: vagrant ssh -c "sudo bash /vagrant/harden.sh"
  config.vm.provision "shell", name: "harden",
    inline: "VAGRANT_SKIP_SSHD=1 bash /vagrant/harden.sh"

  # SELinux controls (VM-only — containers share host kernel)
  config.vm.provision "shell", name: "selinux",
    inline: "bash /vagrant/vm-only/selinux.sh"

  # firewalld rules (VM-only — unsafe in unprivileged containers)
  config.vm.provision "shell", name: "firewall",
    inline: "bash /vagrant/vm-only/firewall.sh"
end
